[Unit]
Description=leyline-web reader instance %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=leyline
Group=leyline
ExecStart=/usr/bin/leyline-web -config /etc/leyline-web/%i.yaml -themes /opt/leyline-web/themes/config/themes
Restart=on-failure
RestartSec=2

# Hardening (mirrors the web template's plain unit). PDF/search caches go to
# /var/cache/leyline-web/{pdf,search}: the engine derives them from
# XDG_CACHE_HOME, and CacheDirectory= keeps that tree writable under
# ProtectSystem=strict and owned by leyline:leyline. The instance reads its
# config (/etc/leyline-web/%i.yaml), the shared theme clone
# (/opt/leyline-web/themes) and the vault FS read-only — no ReadWritePaths
# needed beyond the cache.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
CacheDirectory=leyline-web
Environment=XDG_CACHE_HOME=/var/cache
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
